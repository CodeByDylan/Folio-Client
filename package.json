{
	"name": "folio-client",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build:theme": "pnpm --filter @dylandebeer/theme-pastel build",
		"dev": "pnpm run build:theme && vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "pnpm run build:theme && vite build",
		"preview": "vite preview",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"typecheck": "pnpm run build:theme && tsc --noEmit",
		"prepare": "husky",
		"api:generate": "openapi-ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@astryxdesign/core": "catalog:",
		"@dylandebeer/theme-pastel": "workspace:*",
		"@heroicons/react": "^2.2.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@astryxdesign/cli": "catalog:",
		"@biomejs/biome": "2.4.5",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@hey-api/openapi-ts": "^0.99.0",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"typescript": "catalog:",
		"vite": "^8.0.0",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched"
	}
}
